{
    "id":  null,
    "uid":  "fastapi-red",
    "title":  "FastAPI | RED Observability Dashboard",
    "description":  "Rate, Errors and Duration monitoring using Prometheus and Grafana.",
    "tags":  [
                 "RED",
                 "FastAPI",
                 "Prometheus",
                 "Observability",
                 "T2.2"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "5s",
    "time":  {
                 "from":  "now-15m",
                 "to":  "now"
             },
    "panels":  [
                   {
                       "id":  1,
                       "type":  "stat",
                       "title":  "REQUEST RATE",
                       "description":  "Average HTTP requests per second.",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(rate(http_requests_total[5m]))",
                                           "legendFormat":  "Requests/sec",
                                           "instant":  true
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps",
                                                            "decimals":  2
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "colorMode":  "background",
                                       "graphMode":  "area",
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "values":  false
                                                         }
                                   }
                   },
                   {
                       "id":  2,
                       "type":  "stat",
                       "title":  "5XX ERROR RATE",
                       "description":  "Percentage of server-side errors.",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  8,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "100 * sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.000001)",
                                           "legendFormat":  "Error percentage",
                                           "instant":  true
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "decimals":  2,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "orange",
                                                                                                 "value":  1
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  5
                                                                                             }
                                                                                         ]
                                                                           }
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "colorMode":  "background",
                                       "graphMode":  "area",
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "values":  false
                                                         }
                                   }
                   },
                   {
